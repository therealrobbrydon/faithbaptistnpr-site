  "image": "/assets/img/event-seniors-idlewild-christmas-2026-12-12.jpg",
  "image_dimensions": "1672x941",
  "og_image": "https://faithbaptistnpr.com/assets/img/event-seniors-idlewild-christmas-2026-12-12.jpg",
  "description": "🎄You are invited to join our Seniors Ministry as they attend the annual Christmas Production at Idlewild Baptist Church! “Melodies of Christmas,” Saturday, December 12, 4 PM. Meet at Faith at 2:15 PM. Tickets $18 by cash or check, $20 online. Sign up by Monday, November 16.",
  "excerpt_html": "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\"><div class=\"sqs-block-content\"><div class=\"sqs-html-content\"><p data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\">🎄You are invited to join our Seniors Ministry as they attend the annual Christmas Production at Idlewild Baptist Church!</p><p data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\">“Melodies of Christmas” — Saturday, December 12, 4 PM to 6 PM, at Idlewild in Tampa.</p></div></div></div></div></div></div>",
  "body_html": "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\"><div class=\"sqs-block-content\"><div class=\"sqs-html-content\"><p data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\">🎄You are invited to join our Seniors Ministry as they attend the annual Christmas Production at Idlewild Baptist Church!</p><p data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\">“Melodies of Christmas” — Saturday, December 12, 4 PM to 6 PM, at Idlewild in Tampa.</p><p data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\">Meet at Faith at 2:15 PM, leaving at 2:30 PM. From the church property, you may drive separately or carpool to Idlewild in Tampa. The group plans to stop for dinner after the production before returning to Faith.</p><p data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\">Tickets: 36 reserved, first-come, first-served. Your ticket will be reserved when payment is received.</p><p data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\">Cost: $18 if paying by cash or check made payable to Faith Baptist Church (memo: “Idlewild Christmas Production”); $20 if paying online.</p><p data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\">Tickets will be available until Monday, November 16.</p><p data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\"><a href=\"https://fbcbelong.ccbchurch.com/goto/forms/745/responses/new\" target=\"_blank\" rel=\"noopener\">Sign up</a></p></div></div></div></div></div></div>"
 },
